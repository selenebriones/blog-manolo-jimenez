# Conexión a PostgreSQL. En local, el contenedor de Docker; en Vercel, la de Neon.
DATABASE_URL=postgresql://postgres:CONTRASEÑA@127.0.0.1:5432/mi-historia-manolo

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
# En Vercel NO se define mientras no haya dominio propio: se usa la URL de producción de Vercel.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Fotos en Vercel Blob (solo producción). Vercel la crea al conectar un Blob store al proyecto.
# Sin ella, las fotos se guardan en public/media (lo normal en local).
BLOB_READ_WRITE_TOKEN=

# Publicaciones de Facebook en la portada (sección "Síguenos en Facebook").
# Token de acceso de la PÁGINA (larga duración) con permisos pages_show_list y pages_read_engagement.
# Sin estas variables la sección no se muestra (en desarrollo se ve una vista previa de ejemplo).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Opcional: versión de la Graph API
FACEBOOK_GRAPH_VERSION=v23.0
